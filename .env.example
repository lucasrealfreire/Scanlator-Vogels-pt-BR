# =============================================================================
# Scanlator Vogels PT-BR — Configuracao Local (Etapa 1: PoC + Gemini Free Tier)
# =============================================================================
# Obtenha sua chave GRATUITA em: https://aistudio.google.com/apikey
# IMPORTANTE: NAO vincule faturamento (billing) para garantir custo R$ 0,00.
GEMINI_API_KEY=

# Modelo estritamente limitado a whitelist gratuita (Free Tier).
# Modelos permitidos (verificados via API + Free Tier oficial):
#   - gemini-3.5-flash-lite  (padrao — rapido e maior cota diaria gratuita)
#   - gemini-3.1-flash-lite
#   - gemini-3.6-flash
#   - gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Dispositivo preferencial para modelos locais: auto | cuda | cpu
SCANLATOR_DEVICE=auto

# Limite conservador de VRAM livre minima (MB) antes de acionar fallback para CPU
# (pensado para RTX 5060 Ti 8 GB compartilhada com jogos/desktop)
SCANLATOR_MIN_FREE_VRAM_MB=900

# Timeout HTTP da chamada ao Gemini (segundos)
GEMINI_TIMEOUT_SECONDS=45

# Parametros estruturais ja preparados para a Etapa 2 (microservico sob demanda)
# NUNCA inicia com o Windows; ligado/desligado pela extensao via Native Messaging.
SCANLATOR_HOST=127.0.0.1
SCANLATOR_PORT=8765
SCANLATOR_IDLE_SHUTDOWN_SECONDS=300
